# ==========================================
# Bill Pilot — Environment Configuration Template (.env.example)
# ==========================================

# Server Port
PORT=5500

# MongoDB Connection URI
DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# JWT Authentication
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Shared secret required by POST /api/v1/workflows/** (header X-Workflow-Token); endpoint disabled if empty
WORKFLOW_TOKEN=

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email Delivery (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Rate Limiting (Bucket4j Token Bucket)
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=25
RATE_LIMIT_REFILL_DURATION=10
