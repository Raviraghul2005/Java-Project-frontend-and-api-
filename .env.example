# ==========================================
# Bill Pilot — Environment Configuration Template (.env.example)
# ==========================================

# Server Port
PORT=5500

# MongoDB Connection URI
DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Email Delivery (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Rate Limiting (Bucket4j Token Bucket)
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=25
RATE_LIMIT_REFILL_DURATION=10
